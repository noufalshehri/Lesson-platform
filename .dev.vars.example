# Copy to .dev.vars for local `npx wrangler pages dev`. In production set these in
# Cloudflare Pages → Settings → Variables and Secrets (as *Secrets* for keys).
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional second provider (any OpenAI-compatible API: Groq, OpenRouter, Mistral, OpenAI…)
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_LABEL=Groq
